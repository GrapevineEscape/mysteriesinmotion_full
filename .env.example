# Render supplies the internal PostgreSQL URL.
DATABASE_URL="postgresql://user:password@host:5432/online_mystery"

# Generate a long random value before production.
AUTH_SECRET=""

# Public production URL, such as https://online-mystery.onrender.com
APP_URL="http://localhost:3000"

# Scope the session cookie to the parent domain so one sign-in covers the
# marketing site, the troupe portal, and the play subdomain. Leave this empty
# in local development, where the cookie stays on the current host.
SESSION_COOKIE_DOMAIN=""

# Square payment credentials
NEXT_PUBLIC_SQUARE_APPLICATION_ID=""
NEXT_PUBLIC_SQUARE_LOCATION_ID=""
SQUARE_ACCESS_TOKEN=""
SQUARE_WEBHOOK_SIGNATURE_KEY=""

# Transactional email credentials
EMAIL_FROM=""
RESEND_API_KEY=""

# Where booking enquiries from the marketing site are sent. Accepts a
# comma-separated list. Falls back to ADMIN_EMAIL when empty.
BOOKING_NOTIFICATION_EMAIL=""

# Semantic grading for fill-in-the-blank answers
OPENAI_API_KEY=""
OPENAI_GRADING_MODEL="gpt-5.6-luna"

# Protected video credentials
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_STREAM_API_TOKEN=""
CLOUDFLARE_STREAM_SIGNED_URLS="false"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_DEFAULT_BUCKET="online-mystery-images"

# Future public domain. Keep APP_URL pointed at the active Render URL until DNS
# is connected, then change it to https://play.inmotionmysteries.com.
PUBLIC_PLAY_DOMAIN="play.inmotionmysteries.com"

# Initial administrator
ADMIN_EMAIL=""
