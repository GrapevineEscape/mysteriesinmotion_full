# Render supplies the internal PostgreSQL URL. For local development run
# `npm run db:local` and use the URL it prints.
DATABASE_URL="postgresql://user:password@host:5432/mysteriesinmotion"

# Generate a long random value before production.
AUTH_SECRET=""

# Public production URL, such as https://mysteriesinmotion.com
APP_URL="http://localhost:3000"

# Initial administrator. This address is granted administration on first
# sign-in, and is the fallback inbox for booking enquiries.
ADMIN_EMAIL=""

# --- Hostnames -------------------------------------------------------------
# One deployment serves both. The apex carries the marketing site, the troupe
# portal, and administration; the play subdomain carries the online mysteries.
# Leave PUBLIC_PLAY_DOMAIN empty until its DNS is connected, and the catalog
# stays reachable on the apex in the meantime.
PUBLIC_SITE_DOMAIN="mysteriesinmotion.com"
PUBLIC_PLAY_DOMAIN=""

# Holds back the public marketing pages while the site is being finished. The
# troupe portal, administration, and sign-in stay reachable.
PUBLIC_COMING_SOON="true"

# Scope the session cookie to the parent domain so one sign-in covers the
# marketing site, the troupe portal, and the play subdomain. Leave this empty
# in local development, where the cookie stays on the current host.
SESSION_COOKIE_DOMAIN=""

# --- Scheduling ------------------------------------------------------------
# The troupe's local timezone. Performance days, casting cut-offs, and every
# date shown to a performer are resolved in this zone rather than the server's.
APP_TIMEZONE="America/Chicago"

# --- Transactional email ---------------------------------------------------
# Required in production: every account signs in with an emailed code. Outside
# production, messages are written to the server log instead.
EMAIL_FROM=""
RESEND_API_KEY=""

# Where booking enquiries from the marketing site are sent. Accepts a
# comma-separated list. Falls back to ADMIN_EMAIL when empty.
BOOKING_NOTIFICATION_EMAIL=""

# --- File storage (Cloudflare R2) -----------------------------------------
# Scripts and headshots are private: they are stored here and served through
# short-lived signed URLs, never from a guessable public path.
CLOUDFLARE_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_ASSET_BUCKET="mysteriesinmotion-assets"
R2_DEFAULT_BUCKET="online-mystery-images"

# --- Protected video ------------------------------------------------------
CLOUDFLARE_STREAM_API_TOKEN=""
CLOUDFLARE_STREAM_SIGNED_URLS="false"

# --- Square payments (online mysteries) ------------------------------------
NEXT_PUBLIC_SQUARE_APPLICATION_ID=""
NEXT_PUBLIC_SQUARE_LOCATION_ID=""
SQUARE_ACCESS_TOKEN=""
SQUARE_WEBHOOK_SIGNATURE_KEY=""

# --- Answer grading -------------------------------------------------------
OPENAI_API_KEY=""
OPENAI_GRADING_MODEL="gpt-5.6-luna"
