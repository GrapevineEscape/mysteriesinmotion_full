{
  "name": "mysteriesinmotion",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <27"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "prisma migrate deploy && next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "db:local": "node scripts/dev-database.mjs",
    "db:seed": "node --import tsx prisma/seed.ts",
    "db:counts": "node --env-file-if-exists=.env scripts/db-counts.mjs",
    "migrate:flask": "node --env-file-if-exists=.env --import tsx scripts/migrate-flask.ts",
    "migrate:assets": "node --env-file-if-exists=.env --import tsx scripts/upload-flask-assets.ts",
    "inventory:online": "node --env-file-if-exists=.env --import tsx scripts/inventory-online-content.ts",
    "migrate:online": "node --env-file-if-exists=.env --import tsx scripts/migrate-online-content.ts",
    "scrub:html": "node --env-file-if-exists=.env --import tsx scripts/scrub-html-copy.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "verify:migrations": "node scripts/verify-migrations.mjs",
    "verify:casting": "node --import tsx scripts/verify-casting.ts",
    "verify:migration": "node --import tsx scripts/verify-flask-migration.ts",
    "verify:routes": "node scripts/smoke-admin.mjs",
    "verify:r2": "node --env-file-if-exists=.env --import tsx scripts/verify-r2.ts",
    "images:status": "node --import tsx scripts/customer-image-status.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1097.0",
    "@aws-sdk/s3-request-presigner": "^3.1097.0",
    "@fullcalendar/core": "6.1.21",
    "@fullcalendar/daygrid": "6.1.21",
    "@fullcalendar/list": "6.1.21",
    "@fullcalendar/react": "6.1.21",
    "@prisma/client": "6.19.0",
    "hls.js": "^1.6.16",
    "next": "16.2.12",
    "prisma": "6.19.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@electric-sql/pglite-socket": "^0.2.7",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.20.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.2.12",
    "pg": "^8.22.0",
    "tsx": "^4.23.9",
    "typescript": "^6.0.0"
  }
}
