generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  PERFORMER
  ADMIN
}

enum ShowType {
  STANDARD
  ESCAPE
  ONLINE
}

enum ShowStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ShowDateStatus {
  DRAFT
  OPEN
  FULLY_CAST
  CLOSED
  CANCELED
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AssignmentStatus {
  OFFERED
  CONFIRMED
}

enum AvailabilityStatus {
  AVAILABLE
  UNAVAILABLE
  PARTIAL
}

enum BookingStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum PurchaseStatus {
  PENDING
  PAID
  REFUNDED
  DISPUTED
  COMPLIMENTARY
}

enum AttemptStatus {
  NOT_STARTED
  INVESTIGATING
  READY_TO_ACCUSE
  ACCUSATION_SUBMITTED
  REVEAL_AVAILABLE
  COMPLETED
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  SHORT_TEXT
}

enum IntermissionMediaType {
  NONE
  VIDEO
  IMAGE
}

enum TimerExpirationAction {
  SUBMIT_CURRENT
  MARK_UNANSWERED_INCORRECT
}

enum EvidenceUnlockStage {
  ACT_ONE
  ACT_TWO
}

enum AnswerMatchMode {
  EXACT
  NORMALIZED
  AI_ASSISTED
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  emailVerifiedAt DateTime?
  displayName     String?
  role            UserRole  @default(CUSTOMER)

  firstName   String?
  lastName    String?
  phone       String?
  address     String?
  bio         String?
  headshotUrl String?

  /// When true, this performer only sees the shows in showAccess.
  /// Existing troupe members stay unrestricted.
  showAccessRestricted Boolean @default(false)

  purchases             Purchase[]
  attempts              CaseAttempt[]
  sessions              Session[]
  roleApplications      RoleApplication[]
  showDateInterests     ShowDateInterest[]
  showDateAssignments   ShowDateAssignment[]
  rehearsalAvailability RehearsalAvailability[]
  directedShowDates     ShowDate[]              @relation("ShowDateDirector")
  invitesSent           TroupeInvite[]          @relation("TroupeInviteCreatedBy")
  showAccess            PerformerShowAccess[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model EmailLoginCode {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, expiresAt])
  @@index([expiresAt])
}

/// Admin-issued invitation that grants troupe (PERFORMER) access on first
/// sign-in. Replaces the shared registration code the Flask app used.
model TroupeInvite {
  id          String    @id @default(cuid())
  email       String
  role        UserRole  @default(PERFORMER)
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdById String?
  createdBy   User?     @relation("TroupeInviteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  /// Shows a performer invite may open. Ignored for administrator invites.
  showIds     String[]  @default([])
  createdAt   DateTime  @default(now())

  @@index([email, expiresAt])
  @@index([expiresAt])
}

/// Shows a restricted performer is allowed to open.
model PerformerShowAccess {
  userId String
  showId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  show   Show   @relation(fields: [showId], references: [id], onDelete: Cascade)

  @@id([userId, showId])
  @@index([showId])
}

/// Catalog entity shared by live and online productions. One row per show we
/// offer, regardless of how it is delivered. `type` selects the delivery
/// model; ONLINE shows carry an additional OnlineShowDetail row.
model Show {
  id                String     @id @default(cuid())
  title             String
  slug              String     @unique
  type              ShowType   @default(ONLINE)
  shortDescription  String
  fullDescription   String
  coverImageUrl     String?
  kidFriendly       Boolean    @default(false)
  /// Storage reference for the live performance script (R2 key or https URL).
  scriptUrl         String?
  difficulty        String?
  ageRecommendation String?
  contentAdvisory   String?
  status            ShowStatus @default(DRAFT)
  displayOrder      Int        @default(0)

  online OnlineShowDetail?

  suspects      Suspect[]
  questions     Question[]
  evidenceItems EvidenceItem[]
  resultTiers   ResultTier[]
  purchases     Purchase[]
  attempts      CaseAttempt[]

  roles            Role[]
  roleApplications RoleApplication[]
  showDates        ShowDate[]
  bookings         Booking[]
  performerAccess  PerformerShowAccess[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, status, displayOrder])
}

/// Playback, timing, and commerce configuration for ONLINE shows only.
model OnlineShowDetail {
  id     String @id @default(cuid())
  showId String @unique
  show   Show   @relation(fields: [showId], references: [id], onDelete: Cascade)

  introEnabled    Boolean @default(false)
  introTitle      String?
  introVideoId    String?
  introSkippable  Boolean @default(false)
  introReplayable Boolean @default(false)

  actOneTitle                 String  @default("Act One")
  actOneVideoId               String?
  actOneCanPause              Boolean @default(true)
  actOneRewindSeconds         Int     @default(30)
  lockActOneAfterIntermission Boolean @default(true)

  intermissionTitle      String                @default("Make Your Accusation")
  intermissionMediaType  IntermissionMediaType @default(NONE)
  intermissionVideoId    String?
  intermissionImageUrl   String?
  intermissionVideoLoops Boolean               @default(true)

  accusationTimed       Boolean               @default(false)
  accusationSeconds     Int?
  timerWarningSeconds   Int?
  timerExpirationAction TimerExpirationAction @default(SUBMIT_CURRENT)

  actTwoTitle         String  @default("The Reveal")
  actTwoVideoId       String?
  actTwoCanPause      Boolean @default(true)
  actTwoRewindSeconds Int     @default(30)

  inventoryEnabled       Boolean @default(false)
  situationRoomTitle     String  @default("So, how did you do?")
  resultsMusicEnabled    Boolean @default(false)
  resultsMusicUrl        String?
  vaultTransitionEnabled Boolean @default(true)
  detectiveGaugeEnabled  Boolean @default(true)

  priceCents Int    @default(1000)
  currency   String @default("usd")

  investigationMinutes Int?
  revealMinutes        Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A character in a live show's script.
model Role {
  id           String @id @default(cuid())
  showId       String
  show         Show   @relation(fields: [showId], references: [id], onDelete: Cascade)
  name         String
  gender       String
  age          String
  description  String
  displayOrder Int    @default(0)

  applications RoleApplication[]
  interests    ShowDateInterest[]
  assignments  ShowDateAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([showId, displayOrder])
}

/// Standing roster interest: "I would play this character in future castings."
/// Distinct from ShowDateInterest, which is tied to one scheduled performance.
model RoleApplication {
  id          String            @id @default(cuid())
  performerId String
  performer   User              @relation(fields: [performerId], references: [id], onDelete: Cascade)
  showId      String
  show        Show              @relation(fields: [showId], references: [id], onDelete: Cascade)
  roleId      String
  role        Role              @relation(fields: [roleId], references: [id], onDelete: Cascade)
  status      ApplicationStatus @default(PENDING)
  appliedAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([performerId, roleId])
  @@index([showId, status])
  @@index([performerId, status])
}

/// A scheduled live performance of a show.
model ShowDate {
  id        String         @id @default(cuid())
  showId    String
  show      Show           @relation(fields: [showId], references: [id], onDelete: Cascade)
  date      DateTime
  status    ShowDateStatus @default(DRAFT)
  location  String?
  customer  String?
  attendees Int?
  notes     String?

  /// Days before the performance across which rehearsals are generated.
  rehearsalTimeframe Int  @default(14)
  requiredRehearsals Int  @default(4)
  minPerformers      Int?
  maxPerformers      Int?

  techDate     DateTime?
  techLocation String?

  directorId String?
  director   User?   @relation("ShowDateDirector", fields: [directorId], references: [id], onDelete: SetNull)

  rehearsals  Rehearsal[]
  interests   ShowDateInterest[]
  assignments ShowDateAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, date])
  @@index([showId, date])
  @@index([directorId])
}

/// Per-performance, per-role opt-in from a performer, with the scheduling
/// conflicts and questions they raised when applying.
model ShowDateInterest {
  id          String   @id @default(cuid())
  showDateId  String
  showDate    ShowDate @relation(fields: [showDateId], references: [id], onDelete: Cascade)
  roleId      String
  role        Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  performerId String
  performer   User     @relation(fields: [performerId], references: [id], onDelete: Cascade)

  questions            String?
  conflictTech         Boolean  @default(false)
  /// Rehearsal ids the performer flagged as conflicts.
  conflictRehearsalIds String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([showDateId, roleId, performerId])
  @@index([showDateId, roleId])
  @@index([performerId])
}

/// A cast seat for one role on one performance. Offered by an admin or the
/// show's director, then confirmed by the performer.
model ShowDateAssignment {
  id          String           @id @default(cuid())
  showDateId  String
  showDate    ShowDate         @relation(fields: [showDateId], references: [id], onDelete: Cascade)
  roleId      String
  role        Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)
  performerId String
  performer   User             @relation(fields: [performerId], references: [id], onDelete: Cascade)
  status      AssignmentStatus @default(OFFERED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([showDateId, roleId])
  @@index([showDateId, status])
  @@index([performerId, status])
}

model Rehearsal {
  id         String   @id @default(cuid())
  showDateId String
  showDate   ShowDate @relation(fields: [showDateId], references: [id], onDelete: Cascade)
  date       DateTime
  location   String
  notes      String?

  availability RehearsalAvailability[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([showDateId, date])
}

model RehearsalAvailability {
  id          String             @id @default(cuid())
  rehearsalId String
  rehearsal   Rehearsal          @relation(fields: [rehearsalId], references: [id], onDelete: Cascade)
  performerId String
  performer   User               @relation(fields: [performerId], references: [id], onDelete: Cascade)
  status      AvailabilityStatus @default(AVAILABLE)
  note        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([rehearsalId, performerId])
  @@index([performerId])
}

/// Public booking enquiry submitted from the marketing site.
model Booking {
  id            String        @id @default(cuid())
  name          String
  email         String
  phone         String
  showId        String?
  show          Show?         @relation(fields: [showId], references: [id], onDelete: Restrict)
  preferredDate DateTime      @db.Date
  guestCount    Int
  message       String?
  status        BookingStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([showId])
}

model Suspect {
  id           String         @id @default(cuid())
  showId       String
  show         Show           @relation(fields: [showId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  imageUrl     String?
  displayOrder Int            @default(0)
  isSelectable Boolean        @default(true)
  choices      AnswerChoice[]

  @@unique([showId, name])
  @@index([showId, displayOrder])
}

model Question {
  id                String            @id @default(cuid())
  showId            String
  show              Show              @relation(fields: [showId], references: [id], onDelete: Cascade)
  prompt            String
  type              QuestionType      @default(SINGLE_CHOICE)
  pointValue        Int
  imageUrl          String?
  matchMode         AnswerMatchMode   @default(EXACT)
  acceptedAnswers   String[]          @default([])
  aiGradingRubric   String?
  resultExplanation String?
  displayOrder      Int               @default(0)
  required          Boolean           @default(true)
  choices           AnswerChoice[]
  answers           SubmittedAnswer[]

  @@index([showId, displayOrder])
}

model AnswerChoice {
  id                String                  @id @default(cuid())
  questionId        String
  question          Question                @relation(fields: [questionId], references: [id], onDelete: Cascade)
  suspectId         String?
  suspect           Suspect?                @relation(fields: [suspectId], references: [id], onDelete: SetNull)
  label             String
  isCorrect         Boolean                 @default(false)
  displayOrder      Int                     @default(0)
  legacyAnswers     SubmittedAnswer[]       @relation("LegacySubmittedAnswerChoice")
  selectedInAnswers SubmittedAnswerChoice[]

  @@index([questionId, displayOrder])
}

model ResultTier {
  id             String @id @default(cuid())
  showId         String
  show           Show   @relation(fields: [showId], references: [id], onDelete: Cascade)
  name           String
  description    String
  minimumPercent Int
  maximumPercent Int

  @@index([showId, minimumPercent])
}

model Purchase {
  id                      String         @id @default(cuid())
  userId                  String
  user                    User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  showId                  String
  show                    Show           @relation(fields: [showId], references: [id], onDelete: Restrict)
  status                  PurchaseStatus @default(PENDING)
  amountCents             Int
  currency                String         @default("usd")
  stripeCustomerId        String?
  stripeCheckoutSessionId String?        @unique
  stripePaymentIntentId   String?        @unique
  squareCustomerId        String?
  squareOrderId           String?        @unique
  squarePaymentId         String?        @unique
  squareReceiptUrl        String?
  purchasedAt             DateTime?
  startByAt               DateTime?
  playWindowStartedAt     DateTime?
  playWindowEndsAt        DateTime?
  attempts                CaseAttempt[]
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  @@index([showId, status])
  @@index([userId, showId, status, createdAt])
}

model CaseAttempt {
  id                     String            @id @default(cuid())
  userId                 String
  user                   User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  showId                 String
  show                   Show              @relation(fields: [showId], references: [id], onDelete: Restrict)
  purchaseId             String?
  purchase               Purchase?         @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  status                 AttemptStatus     @default(NOT_STARTED)
  teamName               String?
  investigationStartedAt DateTime?
  accusationSubmittedAt  DateTime?
  revealStartedAt        DateTime?
  completedAt            DateTime?
  score                  Int?
  resultTierName         String?
  playbackStage          String            @default("NOT_STARTED")
  progressRevision       Int               @default(0)
  furthestIntroSeconds   Int               @default(0)
  furthestActOneSeconds  Int               @default(0)
  furthestActTwoSeconds  Int               @default(0)
  playbackUpdatedAt      DateTime?
  intermissionStartedAt  DateTime?
  timerExpiresAt         DateTime?
  draftAnswers           Json?
  maximumScore           Int?
  scorePercent           Int?
  answers                SubmittedAnswer[]
  unlockedEvidence       EvidenceUnlock[]
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  @@index([userId, showId, createdAt])
  @@index([purchaseId, createdAt])
  @@index([showId, status])
}

model EvidenceItem {
  id                  String              @id @default(cuid())
  showId              String
  show                Show                @relation(fields: [showId], references: [id], onDelete: Cascade)
  title               String
  description         String?
  fileUrl             String?
  fileMimeType        String?
  iconUrl             String?
  unlockStage         EvidenceUnlockStage @default(ACT_ONE)
  unlockAtSeconds     Int
  displayOrder        Int                 @default(0)
  visibleDuringReveal Boolean             @default(true)
  unlocks             EvidenceUnlock[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([showId, unlockStage, unlockAtSeconds])
  @@index([showId, displayOrder])
}

model EvidenceUnlock {
  id             String       @id @default(cuid())
  attemptId      String
  attempt        CaseAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  evidenceItemId String
  evidenceItem   EvidenceItem @relation(fields: [evidenceItemId], references: [id], onDelete: Cascade)
  unlockedAt     DateTime     @default(now())

  @@unique([attemptId, evidenceItemId])
  @@index([attemptId, unlockedAt])
}

model SubmittedAnswer {
  id              String                  @id @default(cuid())
  attemptId       String
  attempt         CaseAttempt             @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId      String
  question        Question                @relation(fields: [questionId], references: [id], onDelete: Restrict)
  answerChoiceId  String?
  answerChoice    AnswerChoice?           @relation("LegacySubmittedAnswerChoice", fields: [answerChoiceId], references: [id], onDelete: Restrict)
  selectedChoices SubmittedAnswerChoice[]
  writtenAnswer   String?
  pointsAwarded   Int                     @default(0)
  isCorrect       Boolean?
  gradingMethod   String?
  gradingReason   String?
  submittedAt     DateTime                @default(now())

  @@unique([attemptId, questionId])
}

model SubmittedAnswerChoice {
  answerId String
  answer   SubmittedAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  choiceId String
  choice   AnswerChoice    @relation(fields: [choiceId], references: [id], onDelete: Restrict)

  @@id([answerId, choiceId])
  @@index([choiceId])
}
